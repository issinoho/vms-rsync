-#define ERRX(_fmt, ...) \
-	rsync_errx( (_fmt), ##__VA_ARGS__)
+#define ERR(...) \
+	rsync_err( __VA_ARGS__)
+#define ERRX(...) \
+	rsync_errx( __VA_ARGS__)
 
