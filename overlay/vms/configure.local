# configure.local - openrsync's oconfigure answers for OpenVMS (x86-64 and IA64),
# from its own tests compiled and linked natively by tools/features.sh
# (probes/features.com) on: ia64 x86. A feature is 1 only where every node
# has it. tools/prepare.sh runs ./configure with this file to make config.h.
HAVE_ARC4RANDOM=0
HAVE_B64_NTOP=0
HAVE_BLOWFISH=0
HAVE_CAPSICUM=0
HAVE_CRYPT=1
HAVE_CRYPT_NEWHASH=0
HAVE_ENDIAN_H=0
HAVE_ERR=0
HAVE_EXPLICIT_BZERO=0
HAVE_FTS=0
HAVE_GETEXECNAME=0
HAVE_GETPROGNAME=0
HAVE_INFTIM=1
HAVE_LANDLOCK=0
HAVE_LIB_SOCKET=1
HAVE_MD5=0
HAVE_MEMMEM=0
HAVE_MEMRCHR=0
HAVE_MEMSET_S=0
HAVE_MKFIFOAT=0
HAVE_MKNODAT=0
HAVE_OSBYTEORDER_H=0
HAVE_PASSWORD_LEN=0
HAVE_PATH_MAX=1
HAVE_PLEDGE=0
HAVE___PROGNAME=0
HAVE_PROGRAM_INVOCATION_SHORT_NAME=0
HAVE_READPASSPHRASE=0
HAVE_REALLOCARRAY=0
HAVE_RECALLOCARRAY=0
HAVE_SANDBOX_INIT=0
HAVE_SCAN_SCALED=0
HAVE_SECCOMP_FILTER=0
HAVE_SETRESGID=0
HAVE_SETRESUID=0
HAVE_SHA2=0
HAVE_SOCK_NONBLOCK=0
HAVE_STRLCAT=0
HAVE_STRLCPY=0
HAVE_STRNDUP=1
HAVE_STRNLEN=1
HAVE_STRTONUM=0
HAVE_SYS_BYTEORDER_H=0
HAVE_SYS_CDEFS_H=0
HAVE_SYS_ENDIAN_H=0
HAVE_SYS_MKDEV_H=0
HAVE_SYS_QUEUE=0
HAVE_SYS_SYSMACROS_H=0
HAVE_SYS_TREE=0
HAVE_TERMIOS=1
HAVE_TIMINGSAFE_BCMP=0
HAVE_UNVEIL=0
HAVE_WAIT_ANY=0
# Overrides, each with its reason (overlay/vms/configure.overrides):
# VMS has no <endian.h>: overlay/vms/endian.h supplies le32toh() and friends
# (both architectures are little-endian), found on the [.VMS] include path.
HAVE_ENDIAN_H=1
# openrsync's own mknodat()/mkfifoat() (compats.c) work through fchdir(), which
# VMS lacks; vms/vms_at.c supplies both, refusing devices and FIFOs (D6).
HAVE_MKNODAT=1
HAVE_MKFIFOAT=1
# Not tests in tests.c: configure works these out from the build host itself
# (Linux). VMS has no seccomp, <sha2.h> or systrace.
HAVE_SECCOMP_HEADER=0
HAVE_SHA2_H=0
HAVE_SYSTRACE=0
# getprogname() (compats.c) reads __progname, which vms/vms_crtl_init.c defines.
HAVE___PROGNAME=1
